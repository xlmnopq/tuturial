# ---- DSH 沙箱 ACL 备份（工具生成，非项目内容）----
/.acl-recovery/

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- 运行日志 ----
*.log
smoke_all.log

